# Reference values only: Spring Boot does not automatically load this file.
# Set these variables in your shell or IDE before starting each business service.
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-password

# Optional overrides; these are the defaults in application.properties.
PRODUCT_DB_URL=jdbc:postgresql://localhost:5432/product
ORDER_DB_URL=jdbc:postgresql://localhost:5432/order-service
INVENTORY_DB_URL=jdbc:postgresql://localhost:5432/inventory-service
